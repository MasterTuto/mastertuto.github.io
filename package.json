{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run og-images && npm run sitemap",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build:prod": "ng build --configuration production && npm run og-images && npm run sitemap",
    "watch": "ng build --watch --configuration development",
    "deploy": "ng deploy --cname=brenocs.dev.br",
    "test": "ng test",
    "serve:ssr:portfolio": "node dist/portfolio/server/server.mjs",
    "og-images": "node --import ./scripts/ts-resolve.mjs scripts/generate-og-images.mjs",
    "test:ssg": "node --import ./scripts/ts-resolve.mjs --test scripts/test-*.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/tabler-icons": "^36.1.0",
    "docx": "^9.15.3",
    "express": "^5.1.0",
    "fuse.js": "^7.5.0",
    "jspdf": "^4.2.1",
    "modern-screenshot": "^4.7.0",
    "posthog-js": "^1.390.2",
    "qrcode-generator": "^2.0.4",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "~22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~4.0.0",
    "@types/node": "^26.6.6",
    "angular-cli-ghpages": "^3.1.0",
    "autoprefixer": "^10.4.16",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "6.0.3"
  }
}
